{
  "expo": {
    "name": "ELVANOQ",
    "slug": "flixplay",
    "version": "2.17.16",
    "orientation": "default",
    "icon": "./assets/images/brand/ELVANOQ_app_icon_v3.png",
    "scheme": "fastshot",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.fastshot.slitherproduction.flixplay",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand/ELVANOQ_adaptive_foreground_v3.png",
        "backgroundImage": "./assets/images/brand/ELVANOQ_adaptive_background_v2.png",
        "backgroundColor": "#070B14"
      },
      "isTV": true,
      "versionCode": 20261032,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidCleartext",
      "./plugins/withAndroidTV",
      "./plugins/withAndroidArmArchitectures",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand/ELVANOQ_splash_native_mark_v5.png",
          "resizeMode": "contain",
          "backgroundColor": "#03070f"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
