{
  "expo": {
    "name": "FlixPlay",
    "slug": "flixplay",
    "version": "2.8.4",
    "orientation": "default",
    "icon": "./assets/images/flixplay_icon.png",
    "scheme": "fastshot",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.fastshot.slitherproduction.flixplay",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/flixplay_icon.png",
        "backgroundColor": "#07090E"
      },
      "isTV": true,
      "versionCode": 20260927,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidCleartext",
      "./plugins/withAndroidTV",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/flixplay_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#07090E"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
