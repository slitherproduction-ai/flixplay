{
  "expo": {
    "name": "FlixPlay",
    "slug": "flixplay",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/flixplay_icon.png",
    "scheme": "fastshot",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/flixplay_icon.png",
        "backgroundColor": "#07090E"
      },
      "isTV": true,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "MAIN",
          "category": [
            "LAUNCHER",
            "LEANBACK_LAUNCHER"
          ]
        }
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidCleartext",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/flixplay_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#07090E"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/4b36e889-ccf7-44c0-9214-5b72b1f056f7/dev-preview/"
    }
  }
}
