# Staging portal: static assets generated by Vite. Apply only after a reviewed build.
# Replace portal-staging.example.invalid and the root path with approved values.
server {
    listen 443 ssl;
    server_name portal-staging.example.invalid;

    ssl_certificate /etc/letsencrypt/live/portal-staging.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal-staging.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/elvanoq/staging/portal/dist;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location / {
        try_files $uri $uri/ =404;
    }
}
