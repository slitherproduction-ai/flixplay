generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SUPPORT
  ADMIN
}

enum DevicePlatform {
  ANDROID
  ANDROID_TV
  FIRE_TV
  TIZEN
  WEBOS
}

enum LicenseStatus {
  TRIAL
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  SUSPENDED
  REVOKED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  passwordHash String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  devices   Device[]
  licenses  License[]
  payments  Payment[]
  sessions  CustomerSession[]
  adminMfa  AdminMfaCredential?
}

model CustomerSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  mfaVerifiedAt DateTime?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  @@index([userId, expiresAt])
}

model Device {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String?        @db.Uuid
  user        User?          @relation(fields: [userId], references: [id])
  platform    DevicePlatform
  publicCode  String         @unique
  deviceKeyHash String       @unique
  displayName String?
  createdAt   DateTime       @default(now())
  lastSeenAt  DateTime?
  licenses    License[]
  pairingSessions PairingSession[]
  proofChallenges DeviceProofChallenge[]
  proofPublicKey String?
  proofAlgorithm String?
  @@index([userId])
}

model DeviceProofChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @db.Uuid
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  nonceHash String   @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([deviceId, expiresAt])
}

model Plan {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  priceCents    Int
  currency      String   @default("BRL")
  durationDays  Int      @default(365)
  isActive      Boolean  @default(true)
  licenses      License[]
  payments      Payment[]
}

model License {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  user       User          @relation(fields: [userId], references: [id])
  deviceId   String        @db.Uuid
  device     Device        @relation(fields: [deviceId], references: [id])
  planId     String        @db.Uuid
  plan       Plan          @relation(fields: [planId], references: [id])
  status     LicenseStatus @default(TRIAL)
  startsAt   DateTime
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  @@index([deviceId, status])
  @@index([userId, expiresAt])
}

model PairingSession {
  id         String    @id @default(uuid()) @db.Uuid
  deviceId   String    @db.Uuid
  device     Device    @relation(fields: [deviceId], references: [id])
  codeHash   String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  @@index([deviceId, expiresAt])
}

model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  user                User          @relation(fields: [userId], references: [id])
  planId              String        @db.Uuid
  plan                Plan          @relation(fields: [planId], references: [id])
  provider            String
  providerReference   String?
  idempotencyKey      String        @unique
  amountCents         Int
  status              PaymentStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  paidAt              DateTime?
  @@unique([provider, providerReference])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @db.Uuid
  action      String
  subjectType String
  subjectId   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  @@index([createdAt])
}

model AdminMutationReceipt {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @db.Uuid
  requestKey  String   @unique
  operation   String
  targetId    String   @db.Uuid
  result      Json
  createdAt   DateTime @default(now())
  @@index([actorId, createdAt])
}

model AdminMfaCredential {
  userId       String   @id @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretCipher String
  lastUsedStep BigInt   @default(-1)
  failedAttempts Int @default(0)
  lockedUntil DateTime?
  revokedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminMfaRecoveryRequest {
  id String @id @default(uuid()) @db.Uuid
  targetUserId String @db.Uuid
  initiatedById String @db.Uuid
  approvedById String? @db.Uuid
  evidenceReference String
  status String @default("PENDING")
  createdAt DateTime @default(now())
  approvedAt DateTime?
  expiresAt DateTime
  grantHash String? @unique
  grantExpiresAt DateTime?
  grantConsumedAt DateTime?
  @@index([targetUserId, status])
}

model ApiThrottleBucket {
  key String @id
  hits Int @default(0)
  windowEndsAt DateTime
  blockedUntil DateTime?
}
